# .env.sample — copy to .env and fill in values.
# Keep real secrets in the deployment platform secret store.
AUTH_SECRET=replace-with-at-least-32-characters
AUTH_GITHUB_ID=github-oauth-client-id
AUTH_GITHUB_SECRET=github-oauth-client-secret
AUTH_URL=https://portal.example.com
AUTH_TRUST_HOST=true
# GitHub OAuth is used only after portal login, to connect a deployment account.
DATABASE_URL=file:/data/portal.db
APP_ENCRYPTION_KEY=64-hex-characters
# Keep this separate from APP_ENCRYPTION_KEY and inject it only into backup jobs.
# BACKUP_ENCRYPTION_KEY=64-hex-characters
ALLOWED_GITHUB_OWNERS=JJiseong
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_READ_API_TOKEN=read-token
COOLIFY_WRITE_API_TOKEN=write-token
COOLIFY_DEPLOY_API_TOKEN=deploy-token
COOLIFY_PROJECT_UUID=project-uuid
COOLIFY_SERVER_UUID=server-uuid
COOLIFY_GITHUB_APP_UUID=github-app-uuid
COOLIFY_ENVIRONMENT_NAME=production
